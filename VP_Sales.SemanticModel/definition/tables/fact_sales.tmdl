table fact_sales
	lineageTag: 41c245c7-b76f-4e66-8caa-fce5845e9580
	sourceLineageTag: [dbo].[fact_sales]

	measure 'Total Revenue' = SUMX(Fact_Sales, Fact_Sales[Quantity] * Fact_Sales[UnitPrice])
		lineageTag: 81af1956-bae7-407e-a247-a082eb677913

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Gross Profit' = SUM(Fact_Sales[GrossProfit])
		lineageTag: 17490f4a-ff6c-449d-b1a4-93fd74c31feb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Margin %' = DIVIDE([Total Gross Profit], [Total Revenue])
		lineageTag: 8bec759b-e309-4b36-8d88-675fd65d590b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

